# Project root. Leave blank to auto-detect when the folder is copied into the project root.
MAIZE_PROJECT_ROOT=
MAIZE_API_NAME=Maize AI/ML Research API
MAIZE_API_VERSION=0.1.0
MAIZE_API_HOST=127.0.0.1
MAIZE_API_PORT=8000
MAIZE_API_PREFIX=/api/v1
MAIZE_MAX_BATCH_ROWS=500
# Optional: set a secret to protect API routes (X-API-Key). Leave blank for local development.
MAIZE_API_KEY=
MAIZE_CORS_ORIGINS=*
